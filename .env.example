# Discord Bot Credentials
# Get your token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Typhoon AI Credentials
# Get your key from https://opentyphoon.ai/
TYPHOON_API_KEY=your_typhoon_api_key_here

# Together AI Credentials (required for /draw command)
# Get your key from https://together.ai/
TOGETHER_API_KEY=your_together_api_key_here

# Spotify Web API Credentials (optional, required for Spotify Playlist playback)
# Get your credentials from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Optional outbound proxy for yt-dlp when YouTube blocks the deployment IP.
# Keep credentials in .env/Railway Variables and never commit the real value.
# Supported examples: http://user:pass@host:port or socks5://user:pass@host:port
YOUTUBE_PROXY=

# Valorant API Credentials (Unofficial HenrikDev API)
# Get a free API key by signing in at https://api.henrikdev.xyz/dashboard/
VALORANT_API_KEY=your_valorant_api_key_here

# Prokerala Astrology API Credentials
# Create an app at https://api.prokerala.com/
PROKERALA_CLIENT_ID=your_prokerala_client_id_here
PROKERALA_CLIENT_SECRET=your_prokerala_client_secret_here
